#!/bin/bash
set -euo pipefail
# Revision 2: relaunch instances after the runtime IAM policy is attached.
exec > >(tee /var/log/campusconnect-bootstrap.log | logger -t campusconnect-bootstrap -s 2>/dev/console) 2>&1

dnf install -y python3.12 python3.12-pip unzip
install -d -o ec2-user -g ec2-user /opt/campusconnect
aws s3 cp "s3://${bucket_name}/${bundle_key}" /tmp/campusconnect-backend.zip
unzip -q /tmp/campusconnect-backend.zip -d /opt/campusconnect
python3.12 -m venv /opt/campusconnect/.venv
/opt/campusconnect/.venv/bin/pip install --no-cache-dir -r /opt/campusconnect/requirements.txt
chown -R ec2-user:ec2-user /opt/campusconnect

cat >/etc/campusconnect.env <<'ENVVARS'
APP_MODE=aws
AUTH_MODE=cognito
DATABASE_BACKEND=dynamodb
STORAGE_BACKEND=s3
DESCRIPTION_PROVIDER=bedrock
CATEGORY_PROVIDER=${category_provider}
NOTIFICATION_BACKEND=aws
JWT_SECRET=unused-cognito-mode
AWS_REGION=${aws_region}
DYNAMODB_TABLE=${table_name}
S3_BUCKET=${bucket_name}
SQS_QUEUE_URL=${queue_url}
SNS_TOPIC_ARN=${topic_arn}
COGNITO_REGION=${aws_region}
COGNITO_USER_POOL_ID=${user_pool_id}
COGNITO_APP_CLIENT_ID=${user_pool_client_id}
BEDROCK_MODEL_ID=${bedrock_model_id}
SAGEMAKER_ENDPOINT_NAME=${sagemaker_endpoint_name}
SQLITE_PATH=/var/lib/campusconnect/campusconnect.db
UPLOAD_DIR=/var/lib/campusconnect/uploads
CORS_ORIGINS=${cors_origins}
ENVVARS
chmod 0600 /etc/campusconnect.env
install -d -o ec2-user -g ec2-user /var/lib/campusconnect/uploads

cat >/etc/systemd/system/campusconnect.service <<'UNIT'
[Unit]
Description=CampusConnect API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/campusconnect
EnvironmentFile=/etc/campusconnect.env
ExecStart=/opt/campusconnect/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/campusconnect

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now campusconnect.service
