terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.6"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project   = var.project_name
      ManagedBy = "Terraform"
    }
  }
}

# CloudFront viewer certificates must be created in us-east-1. They are
# intentionally input by the operator so DNS validation and domain ownership
# are reviewed before deployment.
provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"
}
