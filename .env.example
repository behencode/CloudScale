# Copy to backend/.env for local development.
# Local mode does not call AWS. Changing a *_provider or *_backend value to an
# AWS service makes the next related request a real AWS API call, which can
# incur charges. There is no automatic fallback to a local substitute.

APP_MODE=local
AUTH_MODE=local
DATABASE_BACKEND=sqlite
STORAGE_BACKEND=local
DESCRIPTION_PROVIDER=local
CATEGORY_PROVIDER=local
NOTIFICATION_BACKEND=local

JWT_SECRET=local-dev-only-change-me-use-a-private-secret
SQLITE_PATH=data/campusconnect.db
UPLOAD_DIR=data/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AWS_REGION=us-east-1
AWS_PROFILE=

DYNAMODB_TABLE=
S3_BUCKET=
SQS_QUEUE_URL=
SNS_TOPIC_ARN=

COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=us-east-1

# Confirm the model id with `aws bedrock list-inference-profiles` before use.
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
SAGEMAKER_ENDPOINT_NAME=
